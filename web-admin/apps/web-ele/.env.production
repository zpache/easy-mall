VITE_BASE=/

# 接口地址：服务器 IP http://101.35.43.129/ 替换为域名（admin context-path 仍为 /admin，nginx /admin → 8081）
VITE_GLOB_API_URL=http://mall-api.easykits.cn/admin

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true

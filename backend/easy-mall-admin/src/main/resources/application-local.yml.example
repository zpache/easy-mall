# 本机私有配置模板：复制为 application-local.yml 后填入真实值
# application-local.yml 已被 .gitignore 忽略，改这个模板不会生效
# 也可以不用本文件，直接设置同名环境变量（环境变量优先级更高）
spring:
  datasource:
    password: your-local-password

easy-mall:
  upload:
    # cos：前端取临时密钥直传 COS（默认）；local：服务端转存本地磁盘（无凭证时开发用）
    mode: cos
    cos:
      # 子账号密钥：只需 sts:GetFederationToken + 目标桶指定前缀的写权限
      secret-id: ${COS_SECRET_ID:your-secret-id}
      secret-key: ${COS_SECRET_KEY:your-secret-key}
      # 形如 easymall-1250000000，后缀就是 APPID
      bucket: ${COS_BUCKET:easy-mall-1254038435}
      region: ${COS_REGION:ap-shanghai}
      # 访问域名：留空用桶默认域名；填 CDN 域名（https://img.example.com）则用它拼 URL
      domain: ${COS_DOMAIN:}
